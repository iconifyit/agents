#!/usr/bin/env bash
#
# agentify — set up the current repo for sync-agents-dev with global
# inheritance + local artifacts. Runs the three canonical commands as
# --dry-run first, then prompts to confirm before running live.
#
#   1. sync-agents-dev init
#   2. sync-agents-dev inherit global $GLOBAL_AGENTS_MD
#   3. sync-agents-dev sync --targets claude

set -euo pipefail

GLOBAL_AGENTS_MD="/Users/scott/github/@agents/AGENTS.md"

if ! command -v sync-agents-dev >/dev/null 2>&1; then
    echo "agentify: sync-agents-dev not found in PATH" >&2
    exit 1
fi

if [[ ! -f "$GLOBAL_AGENTS_MD" ]]; then
    echo "agentify: global AGENTS.md not found at $GLOBAL_AGENTS_MD" >&2
    exit 1
fi

echo "agentify"
echo "  Project:      $(pwd)"
echo "  Inherit from: $GLOBAL_AGENTS_MD"
echo

echo "=== DRY RUN: init ==="
sync-agents-dev init --dry-run

echo
echo "=== DRY RUN: inherit global ==="
sync-agents-dev inherit global "$GLOBAL_AGENTS_MD" --dry-run

echo
echo "=== DRY RUN: sync --targets claude ==="
sync-agents-dev sync --targets claude --dry-run

echo
read -r -p "Run live? Type 'yes' to confirm: " ans
if [[ "$ans" != "yes" ]]; then
    echo "Aborted."
    exit 0
fi

echo
echo "=== LIVE: init ==="
sync-agents-dev init

echo
echo "=== LIVE: inherit global ==="
sync-agents-dev inherit global "$GLOBAL_AGENTS_MD" || true

echo
echo "=== LIVE: sync --targets claude ==="
sync-agents-dev sync --targets claude

echo
echo "agentify complete."
